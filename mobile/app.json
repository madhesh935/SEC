{
  "expo": {
    "name": "GeriCare AI",
    "slug": "gericare-ai",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "gericare",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gericare.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GeriCare AI uses the microphone for your voice companion conversations."
      }
    },
    "android": {
      "package": "com.gericare.app",
      "permissions": ["RECORD_AUDIO", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "GeriCare uses your camera to scan the pairing code from your caregiver.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "GeriCare AI uses the microphone for voice conversations with your companion."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ]
  }
}
