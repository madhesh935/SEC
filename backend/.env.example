APP_ENV=development
APP_NAME=GeriCare AI
API_V1_PREFIX=/api/v1
PORT=8000

FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_WEB_API_KEY=
DEFAULT_CAREGIVER_ROLE_ON_FIRST_LOGIN=true

# Speech-to-text runs locally via faster-whisper.
# Server TTS requires Cloud Text-to-Speech API access and a provisioned private
# Firebase Storage bucket. Credentials must support signed media URLs; ordinary
# user ADC credentials cannot sign. Never put service credentials in the frontend.
WHISPER_MODEL=base

LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CORS_ORIGINS=http://localhost:3000,http://localhost:8081

REPETITION_SIMILARITY_THRESHOLD=0.78
DISTRESS_ALERT_THRESHOLD=60
URGENT_ALERT_THRESHOLD=85

PAIRING_CODE_TTL_SECONDS=600
PAIRING_PIN_TTL_SECONDS=300
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
JWT_SECRET=
JWT_ALGORITHM=HS256

LOG_LEVEL=INFO
